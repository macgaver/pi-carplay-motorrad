# Build-time settings for image/build.sh. Copy to image/config.env (git-ignored) and edit.
# Everything here can also be changed later, without rebuilding:
#   Wi-Fi, country   -> bmw-carplay.txt on the SD card's boot partition (read at every boot)
#   user, SSH, name  -> user-data on the boot partition (read at FIRST boot only)

WIFI_COUNTRY=CA
WIFI_SSID=
WIFI_PASSWORD=

HOSTNAME=bmw-carplay
PI_USER=pi
# Empty password: SSH key only (if a key is found), else a random password is generated
# and printed at the end of the build.
PI_PASSWORD=
# PI_LOCKED=1 with no password and no key: no generated password either; nobody can log in
# until a key is added to user-data on the card (used for the public release images).
PI_LOCKED=
# Public key file(s) allowed to SSH in. Default: ~/.ssh/id_*.pub of whoever runs the build.
SSH_PUBKEY_FILES=
TIMEZONE=

# Extra room in the root filesystem (MiB). It also grows to fill the card at first boot.
EXTRA_MB=768
